<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sau.gym.admin.mapper.SignInMapper">

    <!--  映射查询到的字段 -->
    <resultMap id="signInMap" type="com.sau.gym.model.entity.system.SignIn" autoMapping="true"></resultMap>

    <insert id="insertSignIn">
        INSERT INTO sign_in (token, name, phone, status)
        VALUES (#{token}, #{name}, #{phone}, 0)
    </insert>

    <select id="selectByToken" resultType="com.sau.gym.model.entity.system.SignIn">
        SELECT * FROM sign_in WHERE token = #{token}
    </select>

    <update id="updateStatusByToken">
        UPDATE sign_in
        SET status = 1, sign_time = now()
        WHERE token = #{token} AND status = 0 # 防重复签到
    </update>

    <sql id="findPageWhere">
        <where>
            <if test="name != null and name != ''">
                and name like CONCAT('%',#{name},'%')
            </if>
            <if test="phone != null and phone != ''">
                and phone like CONCAT('%',#{phone},'%')
            </if>
            and is_deleted = 0
        </where>
    </sql>

    <select id="findByPage" resultMap="signInMap">
        select *
        from sign_in
        <include refid="findPageWhere"/>
    </select>

</mapper>