<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sau.gym.admin.mapper.PaymentRecordMapper">

    <!--  插入流水信息   -->
    <insert id="insertOne">
        insert into payment_record (
            pay_no,
            order_no,
            user_id,
            order_type,
            pay_channel,
            amount,
            status,
            pay_time,
            create_time
        ) values (
                     #{payNo},
                     #{orderNo},
                     #{userId},
                     #{orderType},
                     #{payChannel},
                     #{amount},
                     #{status},
                     #{payTime},
                     #{createTime}
                 )
    </insert>

</mapper>