<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sau.gym.admin.mapper.RagSearchLogMapper">

    <resultMap id="RagSearchLogMap"
               type="com.sau.gym.model.entity.rag.RagSearchLog">
        <id property="id" column="id"/>
        <result property="traceId" column="trace_id"/>
        <result property="userId" column="user_id"/>
        <result property="question" column="question"/>
        <result property="answer" column="answer"/>
        <result property="matchedSources" column="matched_sources"/>
        <result property="maxScore" column="max_score"/>
        <result property="minScore" column="min_score"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 插入 RAG 问答日志 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO rag_search_log (
            trace_id,
            user_id,
            question,
            answer,
            matched_sources,
            max_score,
            min_score,
            create_time
        )
        VALUES (
                   #{traceId},
                   #{userId},
                   #{question},
                   #{answer},
                   #{matchedSources},
                   #{maxScore},
                   #{minScore},
                   #{createTime}
               )
    </insert>

    <!-- 根据 traceId 查询 RAG 检索日志 -->
    <select id="selectByTraceId" resultMap="RagSearchLogMap">
        SELECT
            id,
            trace_id,
            user_id,
            question,
            answer,
            matched_sources,
            max_score,
            min_score,
            create_time
        FROM rag_search_log
        WHERE trace_id = #{traceId}
        ORDER BY create_time ASC, id ASC
    </select>

</mapper>