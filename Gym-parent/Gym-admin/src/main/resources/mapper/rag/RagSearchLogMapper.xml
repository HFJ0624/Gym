<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sau.gym.admin.mapper.RagSearchLogMapper">

    <!-- 插入 RAG 问答日志 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO rag_search_log (
            user_id,
            question,
            answer,
            matched_sources,
            max_score,
            min_score,
            create_time
        )
        VALUES (
                   #{userId},
                   #{question},
                   #{answer},
                   #{matchedSources},
                   #{maxScore},
                   #{minScore},
                   NOW()
               )
    </insert>

</mapper>